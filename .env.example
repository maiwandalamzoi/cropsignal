# Google Earth Engine service account credentials.
# Create a service account, register it for Earth Engine, download the JSON key,
# and paste the private key on ONE line with newlines written as \n.
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Alternatively, leave both blank and run `earthengine authenticate` once;
# cropsignal will fall back to those cached user credentials.
